{
  "name": "@guowenzhang/dsh-drawioedit",
  "description": "Edit .drawio diagrams in the DeepSeek Harness Web Sidebar with a bundled offline draw.io editor",
  "version": "1.2.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhang-guo-wen/dsh-drawioedit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*": "./locale/*"
  },
  "engines": {
    "dsh": ">=0.1.7-0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "locale",
    "editor",
    "lib/*.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test:metadata": "node --test tests/plugin-metadata.test.mjs",
    "build": "tsdown -c tsdown.config.ts && node build-client.mjs && node build-stencils.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node tests/artifact.mjs && node tests/stencils.mjs && node tests/editor-assets.mjs && node tests/smoke.mjs && node tests/serve.mjs && node tests/save.mjs && node tests/rename.mjs && node tests/shim.mjs && node tests/shimdelivery.mjs && node tests/boot.mjs && node tests/offline.mjs",
    "prepublishOnly": "node tests/artifact.mjs && node tests/stencils.mjs && node tests/editor-assets.mjs && node tests/smoke.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-0",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.1.7-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-0",
    "@deepseek-ai/dsh-fs": ">=0.1.7-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.1.7-0",
    "@deepseek-ai/dsh-session": ">=0.1.7-0",
    "@deepseek-ai/dsh-session-query": ">=0.1.7-0",
    "@deepseek-ai/dsh-util-workspace-path": ">=0.1.7-0",
    "react": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar-right": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-util-workspace-path": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": "true"
    },
    "@deepseek-ai/dsh-sandbox-policy": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.7-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-0",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.1.7-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-0",
    "@deepseek-ai/dsh-fs": ">=0.1.7-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-0",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-session-query": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": ">=0.1.7-0",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "rolldown": "^1.0.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.7.0"
  }
}
